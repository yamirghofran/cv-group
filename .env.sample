# All values shown are defaults — uncomment only what you need to override.

# --- YOLO detector ---
# BASKETBALL_API_YOLO_WEIGHTS=object-detection/finetuning/runs/basketball_yolo11s/weights/best.pt
# BASKETBALL_API_YOLO_IMGSZ=640
# BASKETBALL_API_YOLO_CONF=0.25
# BASKETBALL_API_YOLO_IOU=0.5
# BASKETBALL_API_YOLO_DEVICE=        # cpu | mps | cuda:0 — leave blank for ultralytics auto-detect

# --- SAM2 tracker (optional) ---
# BASKETBALL_API_SAM2_ENABLED=0      # 1 / true / yes to enable
# BASKETBALL_API_SAM2_CHECKPOINT=object-detection/checkpoints/sam2.1_hiera_large.pt
# BASKETBALL_API_SAM2_MODEL_CFG=configs/sam2.1/sam2.1_hiera_l.yaml
# BASKETBALL_API_SAM2_DEVICE=auto    # auto | cpu | cuda | mps

# --- Pipeline knobs ---
# BASKETBALL_API_WORK_DIR=object-detection/outputs/api
# BASKETBALL_API_FRAME_STRIDE=5
# BASKETBALL_API_CLEANUP_DIST=80.0
# BASKETBALL_API_CLEANUP_MIN_AREA=50
# BASKETBALL_API_MAX_UPLOAD_MB=500

# --- ROBOFLOW ---
ROBOFLOW_API_KEY=replace-with-your-key
ROBOFLOW_WORKSPACE=boriss-workspace-vbstp
ROBOFLOW_PROJECT=basketball_cv_project
ROBOFLOW_VERSION=1